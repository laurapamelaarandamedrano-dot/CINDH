---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITIO } from '../data/sitio';

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion = SITIO.descripcion } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const tituloCompleto = titulo === 'Inicio' ? `${SITIO.nombre} · ${SITIO.nombreCompleto}` : `${titulo} · ${SITIO.nombre}`;
const canonica = new URL(Astro.url.pathname, Astro.site).href;

// Mientras la asociación esté en proceso de constitución, el sitio no se indexa.
// Cambia a `true` cuando quieran aparecer en buscadores.
const INDEXAR = false;

// Política de seguridad de contenido: solo recursos del propio sitio.
// Sin scripts inline, sin estilos inline, sin terceros, sin formularios.
const CSP = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
  "manifest-src 'self'",
  "worker-src 'none'",
  'upgrade-insecure-requests',
].join('; ');
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content={INDEXAR ? 'index, follow' : 'noindex, nofollow, noarchive'} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#13264b" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonica} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <noscript><link rel="stylesheet" href={`${base}noscript.css`} /></noscript>
  </head>
  <body>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>
    <Header />
    <main id="contenido-principal">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
