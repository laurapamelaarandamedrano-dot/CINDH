---
// Mariposa decorativa inspirada en la Carpeta Ejecutiva.
// Solo usa atributos de presentación y clases: nada de estilos inline (CSP).
interface Props {
  paleta?: 'vino-oro' | 'oro-turquesa' | 'lavanda-vino' | 'rosa-crema';
  vuelo?: boolean;
  class?: string;
}
const { paleta = 'vino-oro', vuelo = true, class: clase = '' } = Astro.props;
---

<svg
  class:list={['mariposa', `mariposa--${paleta}`, { 'mariposa--vuelo': vuelo }, clase]}
  viewBox="0 0 100 84"
  aria-hidden="true"
  focusable="false"
>
  <g class="ala ala--izq">
    <ellipse class="ala-sup" cx="29" cy="28" rx="23" ry="15" transform="rotate(-28 29 28)"></ellipse>
    <ellipse class="ala-inf" cx="37" cy="56" rx="11" ry="16" transform="rotate(28 37 56)"></ellipse>
    <circle class="punto" cx="17" cy="23" r="3"></circle>
    <circle class="punto" cx="33" cy="63" r="2.2"></circle>
  </g>
  <g class="ala ala--der">
    <ellipse class="ala-sup" cx="71" cy="28" rx="23" ry="15" transform="rotate(28 71 28)"></ellipse>
    <ellipse class="ala-inf" cx="63" cy="56" rx="11" ry="16" transform="rotate(-28 63 56)"></ellipse>
    <circle class="punto" cx="83" cy="23" r="3"></circle>
    <circle class="punto" cx="67" cy="63" r="2.2"></circle>
  </g>
  <path class="cuerpo" d="M50 20 C 52 36, 51 58, 47 72"></path>
  <path class="antena" d="M50 21 C 47 12, 43 8, 39 6 M50 21 C 53 12, 57 8, 61 6"></path>
</svg>

<style>
  .mariposa .cuerpo {
    fill: none;
    stroke: #2a1a2a;
    stroke-width: 3.2;
    stroke-linecap: round;
  }
  .mariposa .antena {
    fill: none;
    stroke: #2a1a2a;
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .mariposa .punto {
    fill: #fff;
    opacity: 0.75;
  }
  .mariposa--vino-oro .ala-sup {
    fill: #7b1e3e;
  }
  .mariposa--vino-oro .ala-inf {
    fill: #c9962c;
  }
  .mariposa--oro-turquesa .ala-sup {
    fill: #c9962c;
  }
  .mariposa--oro-turquesa .ala-inf {
    fill: #1d8f86;
  }
  .mariposa--lavanda-vino .ala-sup {
    fill: #7c6cc0;
  }
  .mariposa--lavanda-vino .ala-inf {
    fill: #9c2a52;
  }
  .mariposa--rosa-crema .ala-sup {
    fill: #e7c9d3;
  }
  .mariposa--rosa-crema .ala-inf {
    fill: #f1e2bd;
  }
  .mariposa--rosa-crema .cuerpo,
  .mariposa--rosa-crema .antena {
    stroke: #c9bcc0;
  }
</style>
