---
import { NAVEGACION, SITIO } from '../data/sitio';
import Mariposa from './Mariposa.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const actual = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="brand" href={base}>
      <Mariposa paleta="vino-oro" vuelo={false} class="brand__mark" />
      <span class="brand__text">
        <span class="brand__name">{SITIO.nombre}</span>
        <span class="brand__tag">Derechos humanos · Asociación civil</span>
      </span>
    </a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
      <span class="visually-hidden">Abrir menú de navegación</span>
      <span class="nav__toggle-bar" aria-hidden="true"></span>
    </button>

    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav__menu" id="nav-menu">
        {
          NAVEGACION.map((item) => {
            const href = base + item.ruta;
            return (
              <li>
                <a href={href} aria-current={actual === href ? 'page' : undefined}>
                  {item.texto}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  import '../scripts/menu';
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(251 247 243 / 0.9);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--borde);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 74px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--marino);
  }
  :global(.brand__mark) {
    flex: none;
    width: 44px;
    height: auto;
  }
  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .brand__name {
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: 1.45rem;
    letter-spacing: 0.02em;
  }
  .brand__tag {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--tinta-suave);
    white-space: nowrap;
  }
  .nav__menu {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__menu a {
    display: block;
    padding: 8px 11px;
    border-radius: 999px;
    font-size: 0.86rem;
    white-space: nowrap;
    font-weight: 500;
    color: var(--marino);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .nav__menu a:hover {
    background: var(--rosa-tinte);
    color: var(--vino);
  }
  .nav__menu a[aria-current='page'] {
    background: var(--marino);
    color: #fff;
  }
  .nav__toggle {
    display: none;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 12px;
    background: var(--marino);
    cursor: pointer;
    position: relative;
  }
  .nav__toggle-bar,
  .nav__toggle-bar::before,
  .nav__toggle-bar::after {
    position: absolute;
    left: 12px;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition:
      transform 0.25s ease,
      background-color 0.2s ease;
  }
  .nav__toggle-bar {
    top: 22px;
  }
  .nav__toggle-bar::before,
  .nav__toggle-bar::after {
    content: '';
    left: 0;
  }
  .nav__toggle-bar::before {
    top: -7px;
  }
  .nav__toggle-bar::after {
    top: 7px;
  }
  .nav__toggle[aria-expanded='true'] .nav__toggle-bar {
    background: transparent;
  }
  .nav__toggle[aria-expanded='true'] .nav__toggle-bar::before {
    transform: translateY(7px) rotate(45deg);
  }
  .nav__toggle[aria-expanded='true'] .nav__toggle-bar::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 1240px) {
    .nav__toggle {
      display: block;
    }
    .nav {
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--crema);
      border-bottom: 1px solid var(--borde);
      box-shadow: var(--sombra);
      display: none;
    }
    .nav.is-open {
      display: block;
    }
    .nav__menu {
      flex-direction: column;
      padding: 12px var(--gutter) 20px;
    }
    .nav__menu a {
      padding: 12px 16px;
      font-size: 1rem;
    }
  }
</style>
