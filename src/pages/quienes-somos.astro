---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TituloNumerado from '../components/TituloNumerado.astro';
import { SITIO, ETIQUETAS, OBJETIVOS } from '../data/sitio';

const tonos = ['vino', 'turquesa', 'oro', 'lavanda', 'vino'] as const;
---

<BaseLayout titulo="Quiénes somos">
  <PageHero
    eyebrow="Quiénes somos"
    titulo="Conocimiento cercano a las personas"
    lede="Una asociación civil autónoma y sin fines de lucro que une el rigor del conocimiento con el trabajo cercano a las personas."
  />

  <section class="section" aria-labelledby="t-quienes">
    <div class="container prosa">
      <TituloNumerado numero="01" id="t-quienes">Quiénes somos</TituloNumerado>
      <p class="reveal">
        En CINDH creemos que los derechos humanos se defienden mejor cuando se conocen, se estudian y se viven. Somos
        una asociación civil autónoma y sin fines de lucro que investiga, difunde, forma y actúa en favor de los
        derechos humanos, uniendo el rigor del conocimiento con el trabajo cercano a las personas.
      </p>
      <p class="reveal">
        Entendemos los derechos humanos en su sentido más amplio: como la mirada desde la cual se comprenden la
        democracia, la justicia, la seguridad, el desarrollo, la paz, el medio ambiente y la tecnología. Por eso
        reunimos al derecho con la ciencia política, la sociología, la economía, la psicología, la educación, la salud
        pública y la ciencia de datos.
      </p>
      <ul class="pills reveal" aria-label="Lo que nos mueve">
        {ETIQUETAS.map((e) => <li class:list={['pill', `tono-${e.tono}`]}>{e.texto}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--papel" aria-labelledby="t-filosofia">
    <div class="container prosa">
      <TituloNumerado numero="03" id="t-filosofia" tono="turquesa">Filosofía</TituloNumerado>
      <p class="reveal">
        La dignidad humana es nuestro punto de partida y no admite excepciones. Los derechos humanos no viven solo en
        las leyes: se conocen, se ejercen, se exigen y se cumplen todos los días, en la escuela, en la calle, en la
        oficina pública y en la comunidad.
      </p>
      <blockquote class="pull-quote reveal"><p>{SITIO.frase}</p></blockquote>
      <p class="reveal">
        El conocimiento cumple su propósito cuando llega a las personas y mejora su vida. Por eso en CINDH investigar,
        difundir y actuar son parte de un mismo compromiso, que ejercemos con pensamiento crítico, independencia y
        respeto a la pluralidad.
      </p>
    </div>
  </section>

  <section class="section" aria-label="Misión y visión">
    <div class="container grid grid--2">
      <div class="mision reveal">
        <TituloNumerado numero="04" id="t-mision" tono="oro">Misión</TituloNumerado>
        <p>
          Investigar, difundir y promover los derechos humanos desde un enfoque interdisciplinario, y actuar en su
          defensa mediante formación, acompañamiento e incidencia basada en evidencia, en favor de las personas, las
          comunidades y las instituciones responsables de garantizarlos.
        </p>
      </div>
      <div class="vision reveal">
        <TituloNumerado numero="05" id="t-vision" tono="oro">Visión</TituloNumerado>
        <p>
          Ser un referente nacional en la investigación, promoción y defensa de los derechos humanos, reconocido por la
          solidez de su evidencia, su cercanía con las personas y su capacidad de incidir en la vida pública, con
          vínculos académicos y de cooperación internacional.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--papel" aria-labelledby="t-objetivos">
    <div class="container prosa">
      <TituloNumerado numero="06" id="t-objetivos">Objetivos</TituloNumerado>
      <ol class="objetivos reveal-stagger">
        {
          OBJETIVOS.map((o, i) => (
            <li class="reveal">
              <span class:list={['objetivos__n', `tono-${tonos[i]}`]} aria-hidden="true">
                {i + 1}
              </span>
              <span>{o}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .prosa {
    max-width: 880px;
  }
  .mision,
  .vision {
    border-radius: var(--radio-g);
    padding: clamp(24px, 4vw, 40px);
    font-family: var(--fuente-titulo);
    font-size: 1.18rem;
    line-height: 1.65;
  }
  .mision {
    background: linear-gradient(145deg, var(--vino) 0%, #5e1731 100%);
    color: #fbeef2;
  }
  .mision :global(h2) {
    color: #fff;
  }
  .vision {
    background: var(--papel);
    border-left: 6px solid var(--oro);
    color: var(--marino);
  }
  .mision p,
  .vision p {
    margin: 0;
  }
  .objetivos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .objetivos li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--blanco);
    padding: 16px 20px;
    border-radius: 12px;
    box-shadow: var(--sombra);
  }
  .objetivos__n {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--tono);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
  }
</style>
