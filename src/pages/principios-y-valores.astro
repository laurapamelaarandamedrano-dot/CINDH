---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TituloNumerado from '../components/TituloNumerado.astro';
import Icono from '../components/Icono.astro';
import { VALORES, PRINCIPIOS } from '../data/sitio';

const iconos = ['balanza', 'escudo', 'ojo', 'manos', 'libro'] as const;
---

<BaseLayout titulo="Principios y valores">
  <PageHero
    eyebrow="Principios y valores"
    titulo="La dignidad no admite excepciones"
    lede="Lo que nos guía al investigar, al acompañar y al comunicar."
  />

  <section class="section" aria-labelledby="t-valores">
    <div class="container">
      <TituloNumerado numero="07" id="t-valores" tono="turquesa">Valores</TituloNumerado>
      <div class="grid grid--3 reveal-stagger">
        {
          VALORES.map((v) => (
            <div class:list={['side-card', 'reveal', `tono-${v.tono}`]}>
              <p>
                <strong>{v.nombre}.</strong> {v.texto}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--papel" aria-labelledby="t-principios">
    <div class="container">
      <TituloNumerado numero="08" id="t-principios">Principios de actuación</TituloNumerado>
      <ul class="principios reveal-stagger">
        {
          PRINCIPIOS.map((p, i) => (
            <li class="reveal">
              <span class="principios__icono">
                <Icono nombre={iconos[i] ?? 'escudo'} />
              </span>
              <div>
                <h3>{p.nombre}</h3>
                <p>{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .principios {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
  }
  .principios li {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    background: var(--blanco);
    border-radius: var(--radio);
    padding: 22px 24px;
    box-shadow: var(--sombra);
  }
  .principios li:nth-child(4n + 1) {
    --c: var(--vino);
    --t: var(--rosa-tinte);
  }
  .principios li:nth-child(4n + 2) {
    --c: var(--turquesa-texto);
    --t: var(--turquesa-tinte);
  }
  .principios li:nth-child(4n + 3) {
    --c: var(--oro-texto);
    --t: var(--oro-tinte);
  }
  .principios li:nth-child(4n + 4) {
    --c: var(--lavanda-texto);
    --t: var(--lavanda-tinte);
  }
  .principios__icono {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--t);
    color: var(--c);
  }
  .principios__icono :global(.icon) {
    width: 26px;
    height: 26px;
  }
  .principios h3 {
    margin-bottom: 0.3em;
  }
  .principios p {
    margin: 0;
  }
</style>
